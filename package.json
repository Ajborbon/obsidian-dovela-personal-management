{
  "name": "obsidian-dovela-personal-management",
  "version": "2.0.0-alpha.1",
  "description": "GTD + segundo cerebro para Obsidian (Dovela v2): índice incremental, captura, registro de tiempo, Pomodoro, foco, backlinks y journal.",
  "license": "GPL-3.0-or-later",
  "author": "Ajborbon",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && node scripts/build.mjs production",
    "dev": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test && node scripts/build.mjs production"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@tsconfig/strictest": "2.0.5",
    "@types/node": "22.10.2",
    "esbuild": "0.24.2",
    "eslint": "9.17.0",
    "obsidian": "1.8.7",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vitest": "2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
